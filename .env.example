APP_NAME=TriageDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI providers --------------------------------------------------------
# Set a key for one provider or several. Each agent tries its providers in
# order, skipping any without a key or past its daily limit, and fails over
# when one is down or rate limited.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=

# Order per agent. Triage is one short classification; the support agent
# runs the tool loop and the approval flow.
AI_TRIAGE_PROVIDERS=openai,anthropic
AI_SUPPORT_PROVIDERS=anthropic,openai

# Leave blank for each provider's cheapest model (Claude Haiku 5.5, GPT-6 Luna).
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=

# Daily spend limit per provider in US dollars, counted from real token usage
# at list prices (config/triagedesk.php). 0 switches a provider off.
AI_ANTHROPIC_DAILY_LIMIT_USD=3
AI_OPENAI_DAILY_LIMIT_USD=6
# The day starts at midnight in this time zone.
AI_BUDGET_TIMEZONE=Asia/Shanghai

# Stops a single agent run after this many tokens.
AI_RUN_TOKEN_LIMIT=40000

# A refund runs without approval only while it, plus what was already refunded
# on that payment and auto-refunded on that ticket, stays within this many dollars.
REFUND_AUTO_APPROVE_LIMIT=50

# --- Public demo -----------------------------------------------------------
# In demo mode visitors see recorded runs; live model runs need the access code.
# With no access code, nobody can start a live run.
DEMO_MODE=false
DEMO_ACCESS_CODE=
DEMO_LIVE_RUNS_PER_DAY=400
DEMO_CHATS_PER_IP_PER_DAY=15
DEMO_TRIAGES_PER_IP_PER_DAY=10
# Where "php artisan triagedesk:record" saves the runs the nightly reset restores.
# DEMO_RECORDINGS_PATH=storage/app/recordings.json

VITE_APP_NAME="${APP_NAME}"
